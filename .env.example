# Copy this file to `.env` and fill in your keys.
# At minimum, set one of OPENAI_API_KEY or GEMINI_API_KEY.

# === LLM providers (set the ones you plan on using) ===
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# === Tools ===
# Required for BrowseComp-Plus and for Finance-Agent's web_search tool.
TAVILY_API_KEY=

# === Optional tracing ===
# LANGFUSE_HOST=https://us.cloud.langfuse.com
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
